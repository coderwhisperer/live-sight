"""Compare v1, v1.1, v1.2 (Path A — corrections-only) on demo images."""
import json
import httpx

def call_vllm(model, image_b64, prompt):
    with httpx.Client(timeout=120.0) as client:
        r = client.post('http://localhost:8000/v1/chat/completions', json={
            'model': model,
            'messages': [{
                'role': 'user',
                'content': [
                    {'type': 'image_url', 'image_url': {'url': f'data:image/jpeg;base64,{image_b64}'}},
                    {'type': 'text', 'text': prompt}
                ]
            }],
            'temperature': 0.0,
            'max_tokens': 600,
        })
        return r.json()['choices'][0]['message']['content']

def load_jsonl_row(path, row_idx):
    with open(path) as f:
        for i, line in enumerate(f):
            if i == row_idx:
                return json.loads(line.strip())
    return None

read_prompt = 'Read out the text in this image clearly.'

cases = [
    ('A — study-methods note (v1 hero comparison)',
     '/shared-docker/data/interactions/2026-05-07.jsonl', 7),
    ('B — RAKtherm signage (only in v1.1+/v1.2 training)',
     '/shared-docker/data/interactions/2026-05-09.jsonl', 12),
]

for label, path, row in cases:
    d = load_jsonl_row(path, row)
    print(f'\n========== {label} ==========')
    print(f'expected (user_correction):')
    print(f'  {d["user_correction"][:300] if d.get("user_correction") else d["response"][:300]}')
    print()
    for model in ['livesight-v1', 'livesight-v1_1', 'livesight-v1_2']:
        try:
            out = call_vllm(model, d['image_b64'], read_prompt)
            print(f'--- {model} ---')
            print(out)
            print()
        except Exception as e:
            print(f'--- {model} ---  ERROR: {e}\n')
