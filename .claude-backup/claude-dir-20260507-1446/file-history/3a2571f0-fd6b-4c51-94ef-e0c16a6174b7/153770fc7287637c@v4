import httpx

from livesight.shared.config import VLLM_MODEL_NAME, VLLM_TIMEOUT_S, VLLM_URL


async def describe_image(
    image_b64: str,
    user_prompt: str,
    system_prompt: str | None = None,
) -> str:
    """Call vLLM with image + optional system prompt + user prompt.

    Note on message structure: Qwen2-VL applies an OpenAI-style `system`
    role weakly — directives there can be ignored when the user message
    contains an image. We instead prepend the system prompt to the text
    part of the user message, which makes it a directive prefix the
    model treats as part of the active instruction. The public API
    (system_prompt arg) is unchanged so callers don't need to know.
    """
    if system_prompt:
        text_content = f"{system_prompt}\n\n{user_prompt}"
    else:
        text_content = user_prompt

    messages = [
        {
            "role": "user",
            "content": [
                {
                    "type": "image_url",
                    "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"},
                },
                {"type": "text", "text": text_content},
            ],
        }
    ]
    payload = {
        "model": VLLM_MODEL_NAME,
        "messages": messages,
        "max_tokens": 200,
    }
    async with httpx.AsyncClient(timeout=VLLM_TIMEOUT_S) as client:
        resp = await client.post(f"{VLLM_URL}/v1/chat/completions", json=payload)
        resp.raise_for_status()
        return resp.json()["choices"][0]["message"]["content"]
