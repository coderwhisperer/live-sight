import httpx

from livesight.shared.config import VLLM_MODEL_NAME, VLLM_TIMEOUT_S, VLLM_URL


async def describe_image(
    image_b64: str,
    user_prompt: str,
    system_prompt: str | None = None,
) -> str:
    """Call vLLM with image + optional system prompt + user prompt.

    Returns the assistant's text content from the chat completion.
    """
    messages: list[dict] = []
    if system_prompt:
        messages.append({"role": "system", "content": system_prompt})
    messages.append(
        {
            "role": "user",
            "content": [
                {
                    "type": "image_url",
                    "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"},
                },
                {"type": "text", "text": user_prompt},
            ],
        }
    )
    payload = {
        "model": VLLM_MODEL_NAME,
        "messages": messages,
        "max_tokens": 200,
    }
    async with httpx.AsyncClient(timeout=VLLM_TIMEOUT_S) as client:
        resp = await client.post(f"{VLLM_URL}/v1/chat/completions", json=payload)
        resp.raise_for_status()
        return resp.json()["choices"][0]["message"]["content"]
